{
  "name": "alfred-anycode",
  "version": "1.1.0",
  "description": "Search and open any project in any IDE.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build:release": "npm run check && node scripts/build-release.js",
    "check": "npm test && npm run validate",
    "postinstall": "node scripts/install-workflow.js",
    "prepack": "node scripts/assert-publishable.js",
    "prepublishOnly": "npm run check && node scripts/assert-publishable.js",
    "preuninstall": "node scripts/uninstall-workflow.js",
    "release": "semantic-release",
    "test": "node --test",
    "validate": "node scripts/validate-workflow.js",
    "version:bump": "node scripts/bump-version.js"
  },
  "author": {
    "name": "Wilson",
    "email": "willworkgogogo@gmail.com"
  },
  "keywords": [
    "ide",
    "ide-launcher",
    "ide-switcher",
    "multi-ide",
    "open-in-ide",
    "project-launcher",
    "project-opener",
    "code-editor",
    "alfred",
    "alfred-workflow",
    "macos",
    "vscode",
    "cursor",
    "webstorm",
    "zed",
    "codex"
  ],
  "homepage": "https://github.com/wilsonyiyi/alfred-anycode#readme",
  "bugs": {
    "url": "https://github.com/wilsonyiyi/alfred-anycode/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wilsonyiyi/alfred-anycode.git"
  },
  "license": "GPL-3.0-or-later",
  "preferGlobal": true,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "46CF5385-7B12-47EC-A34B-D36168267B0A.png",
    "A230553D-D083-45EE-AAFD-02C49F29CED6.png",
    "assets/editor-icons",
    "icon.png",
    "index.js",
    "info.plist",
    "LICENSE",
    "README.md",
    "scripts",
    "src"
  ],
  "dependencies": {
    "fast-glob": "^3.3.3"
  },
  "devDependencies": {
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "plist": "^3.1.1",
    "semantic-release": "^25.0.9"
  }
}
